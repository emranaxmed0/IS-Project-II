/* ShambaGuide Brand Palette & Custom Overrides */
:root {
    --sg-green-primary: #2e7d32;
    --sg-green-dark: #1b5e20;
    --sg-green-light: #e8f5e9;
    --sg-bg-body: #f4f7f6;
}

body {
    background-color: var(--sg-bg-body);
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
}

/* Custom Card Styling */
.auth-card {
    border: none;
    border-radius: 12px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.auth-card:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1) !important;
}

/* Custom Shamba Primary Buttons */
.btn-shamba {
    background-color: var(--sg-green-primary);
    color: #ffffff;
    border: none;
    font-weight: 600;
}

.btn-shamba:hover {
    background-color: var(--sg-green-dark);
    color: #ffffff;
}

/* Brand Text Color */
.text-shamba {
    color: var(--sg-green-primary) !important;
}

/* Focus Ring Customization */
.form-control:focus, .form-select:focus {
    border-color: var(--sg-green-primary);
    box-shadow: 0 0 0 0.25rem rgba(46, 125, 50, 0.25);
}